filters:
  and:
    - tipo == "tarea"
    - file.ext == "md"
formulas:
  dias_para_vencer: if(vence, (date(vence) - today()).days, "")
  prioridad_label: if(prioridad == "alta", "🔴 Alta", if(prioridad == "media", "🟡 Media", "🟢 Baja"))
properties:
  estado:
    displayName: Estado
  modulo:
    displayName: Módulo
  formula.prioridad_label:
    displayName: Prioridad
  formula.dias_para_vencer:
    displayName: Días p/ vencer
views:
  - type: table
    name: Tablero por estado
    groupBy:
      property: estado
      direction: ASC
    order:
      - file.name
      - formula.prioridad_label
      - modulo
      - vence
      - formula.dias_para_vencer
  - type: table
    name: Pendientes
    filters:
      and:
        - estado != "hecho"
    order:
      - file.name
      - estado
      - formula.prioridad_label
      - vence
