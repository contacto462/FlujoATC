filters:
  and:
    - tipo == "tabla"
    - file.ext == "md"
properties:
  modulo:
    displayName: Módulo
  db:
    displayName: Motor
  file.name:
    displayName: Tabla
views:
  - type: table
    name: Tablas por módulo
    groupBy:
      property: modulo
      direction: ASC
    order:
      - file.name
      - modulo
      - db
